msgid ""
msgstr ""
"Project-Id-Version: Profotograaf for WordPress\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: nl_NL\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: profotograaf\n"

msgid "Profotograaf enquiries"
msgstr "Profotograaf-aanvragen"

msgid "You do not have permission to do this."
msgstr "Je hebt hiervoor geen toestemming."

msgid "Send the enquiries from your contact forms to your Profotograaf inbox. Switch a form on and check which field feeds which part of the enquiry. Nothing is sent for a form you leave off."
msgstr "Stuur de aanvragen uit je contactformulieren naar je Profotograaf-inbox. Zet een formulier aan en controleer welk veld welk deel van de aanvraag vult. Voor een formulier dat uit staat wordt niets verstuurd."

msgid "This site is not connected to Profotograaf, so enquiries wait in a queue."
msgstr "Deze site is niet verbonden met Profotograaf, dus aanvragen wachten in een wachtrij."

msgid "Connect this site"
msgstr "Verbind deze site"

msgid "No supported form plugin was found. Install Contact Form 7, WPForms or Gravity Forms and create a form."
msgstr "Er is geen ondersteunde formulierplugin gevonden. Installeer Contact Form 7, WPForms of Gravity Forms en maak een formulier."

msgid "Save changes"
msgstr "Wijzigingen opslaan"

msgid "Delivery"
msgstr "Bezorging"

msgid "Waiting to be sent: %1$d. Could not be sent: %2$d."
msgstr "Wacht op verzending: %1$d. Kon niet worden verstuurd: %2$d."

msgid "Name"
msgstr "Naam"

msgid "Email address"
msgstr "E-mailadres"

msgid "Phone"
msgstr "Telefoon"

msgid "Event date"
msgstr "Datum van de gelegenheid"

msgid "Message"
msgstr "Bericht"

msgid "Send submissions of this form to Profotograaf"
msgstr "Stuur inzendingen van dit formulier naar Profotograaf"

msgid "Automatic (%s)"
msgstr "Automatisch (%s)"

msgid "Automatic (no field found)"
msgstr "Automatisch (geen veld gevonden)"

msgid "Do not send"
msgstr "Niet versturen"

msgid "Every other field is sent along as a label and value."
msgstr "Alle andere velden gaan mee als label en waarde."

msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

msgid "Try again"
msgstr "Opnieuw proberen"

msgid "Changes saved."
msgstr "Wijzigingen opgeslagen."

msgid "The enquiries are queued again."
msgstr "De aanvragen staan weer in de wachtrij."

msgid "Enquiry forms"
msgstr "Aanvraagformulieren"
