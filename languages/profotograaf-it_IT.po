msgstr "In attesa di backup"

#: includes/class-backup-labels.php:31
msgid "Being backed up"
msgstr "Backup in corso"

#: includes/class-backup-labels.php:33
msgid "Backed up"
msgstr "Nel backup"

#: includes/class-backup-labels.php:35
msgid "Not backed up"
msgstr "Non nel backup"

