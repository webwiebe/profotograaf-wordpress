parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_array\(\) with array\{method\: string, path\: string, body\: array\<string, mixed\>\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: includes/class-api-client.php

		-
			message: '#^Offset ''body'' on array\{method\: non\-falsy\-string, path\: non\-falsy\-string, body\: array\<string, mixed\>\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
