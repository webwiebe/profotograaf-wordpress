{
  "name": "profotograaf-wordpress",
  "version": "0.2.3",
  "private": true,
  "description": "Profotograaf for WordPress: client galleries, embeds and lead capture.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "sh scripts/install-hooks.sh",
    "build": "node bin/blocks.mjs build",
    "start": "node bin/blocks.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/oxlint-ratchet.mjs && node scripts/oxlint-ratchet.mjs --type-aware",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:gates": "node --test scripts/*.test.mjs",
    "check:file-length": "node scripts/check-file-length.mjs",
    "test:e2e": "playwright test",
    "e2e:up": "bash tests/e2e/up.sh",
    "e2e:down": "docker compose -f tests/e2e/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wordpress__block-editor": "^15.0.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@wordpress/api-fetch": "^8.0.0",
    "@wordpress/block-editor": "^19.0.0",
    "@wordpress/blocks": "^17.0.0",
    "@wordpress/browserslist-config": "^7.0.0",
    "@wordpress/components": "^43.0.0",
    "@wordpress/data": "^11.0.0",
    "@wordpress/element": "^10.0.0",
    "@wordpress/i18n": "^7.0.0",
    "@wordpress/scripts": "^37.0.0",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@profotograaf/embed": "file:embed-package/profotograaf-embed-0.3.0.tgz",
    "qrcode-generator": "2.0.4"
  }
}
