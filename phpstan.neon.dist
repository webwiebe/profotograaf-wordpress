includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	- phpstan-baseline.neon

parameters:
	level: 8
	paths:
		- profotograaf.php
		- uninstall.php
		- includes
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	# Elementor and Divi are not installed here: the builder classes need their base classes.
	scanFiles:
		- tests/stubs/elementor.php
		- tests/stubs/divi.php
	phpVersion: 80100
	# A baseline entry that no longer matches an error is itself an error, so the
	# baseline can only shrink.
	reportUnmatchedIgnoredErrors: true
	tmpDir: .phpstan.cache
