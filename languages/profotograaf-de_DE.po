#: includes/class-api-client.php:146
#: includes/class-gallery-rest.php:166
#: includes/class-gallery-rest.php:184
#: includes/class-gallery-rest.php:211
#: includes/class-photo-list.php:56
msgid "A gallery id is required."
msgstr "Eine Galerie-ID ist erforderlich."

#: includes/class-api-client.php:163
msgid "The request to switch embedding on is not valid."
msgstr "Die Anfrage zum Einschalten der Einbettung ist ungültig."

#: includes/class-api-client.php:173
msgid "This connection may not switch galleries on yet. Connect this site again under Settings > Profotograaf to grant the new permission."
msgstr "Diese Verbindung darf Galerien noch nicht einschalten. Verbinde diese Website unter Einstellungen > Profotograaf erneut, um die neue Berechtigung zu erteilen."

#: includes/class-api-client.php:212
msgid "A lead needs a name and an email address."
msgstr "Ein Lead braucht einen Namen und eine E-Mail-Adresse."

#: includes/class-api-client.php:314
msgid "That page is not on the Profotograaf platform."
msgstr "Diese Seite gehört nicht zur Profotograaf-Plattform."

#: includes/class-api-client.php:324
#: includes/class-api-client.php:464
#: includes/class-api-client.php:469
msgid "Profotograaf could not be reached."
msgstr "Profotograaf konnte nicht erreicht werden."

#: includes/class-api-client.php:331
msgid "The public page could not be loaded."
msgstr "Die öffentliche Seite konnte nicht geladen werden."

#: includes/class-api-client.php:356
msgid "The connection is being refreshed. Try again in a moment."
msgstr "Die Verbindung wird erneuert. Versuche es gleich noch einmal."

#: includes/class-api-client.php:380
msgid "The connection was ended in your Profotograaf account."
msgstr "Die Verbindung wurde in deinem Profotograaf-Konto beendet."

#: includes/class-api-client.php:449
msgid "The request could not be encoded."
msgstr "Die Anfrage konnte nicht kodiert werden."

#: includes/class-api-errors.php:62
msgid "The connection to Profotograaf has expired. Connect this site again."
msgstr "Die Verbindung zu Profotograaf ist abgelaufen. Verbinde diese Website erneut."

#: includes/class-api-errors.php:64
msgid "Profotograaf asked for fewer connection checks. Trying again shortly."
msgstr "Profotograaf hat um weniger Verbindungsprüfungen gebeten. Ein neuer Versuch folgt in Kürze."

#: includes/class-api-errors.php:66
msgid "Profotograaf does not know this connection code. Start the connection again."
msgstr "Profotograaf kennt diesen Verbindungscode nicht. Starte die Verbindung neu."

#: includes/class-api-errors.php:68
msgid "Profotograaf does not recognise this site. Start the connection again."
msgstr "Profotograaf erkennt diese Website nicht. Starte die Verbindung neu."

#: includes/class-api-errors.php:70
msgid "Profotograaf rejected the enquiry because it is incomplete or invalid."
msgstr "Profotograaf hat die Anfrage abgelehnt, weil sie unvollständig oder ungültig ist."

#: includes/class-api-errors.php:80
msgid "This site is not connected to Profotograaf."
msgstr "Diese Website ist nicht mit Profotograaf verbunden."

#. translators: %d: HTTP status code.
#: includes/class-api-errors.php:105
#, php-format
msgid "The platform reported an error (HTTP %d). Try again later."
msgstr "Die Plattform hat einen Fehler gemeldet (HTTP %d). Versuche es später erneut."

#. translators: %d: HTTP status code.
#: includes/class-api-errors.php:109
#, php-format
msgid "Profotograaf answered with HTTP %d."
msgstr "Profotograaf hat mit HTTP %d geantwortet."

#: includes/class-cron-health.php:142
msgid "Profotograaf lead delivery"
msgstr "Profotograaf-Lead-Zustellung"

#: includes/class-cron-health.php:157
msgid "Profotograaf can deliver leads"
msgstr "Profotograaf kann Leads zustellen"

#: includes/class-cron-health.php:163
msgid "WP-Cron has run recently, so queued leads are delivered on time."
msgstr "WP-Cron wurde kürzlich ausgeführt, daher werden Leads in der Warteschlange rechtzeitig zugestellt."

#: includes/class-cron-health.php:171
msgid "WP-Cron is disabled and leads cannot be delivered"
msgstr "WP-Cron ist deaktiviert und Leads können nicht zugestellt werden"

#: includes/class-cron-health.php:172
msgid "WP-Cron has stopped running and leads cannot be delivered"
msgstr "WP-Cron läuft nicht mehr und Leads können nicht zugestellt werden"

#: includes/class-cron-health.php:179
msgid "Run WordPress cron from the server. Add this line to the crontab of the site:"
msgstr "Führe den WordPress-Cron vom Server aus. Füge diese Zeile zur Crontab der Website hinzu:"

#: includes/class-cron-health.php:195
msgid "Run WordPress cron from the server with this crontab line:"
msgstr "Führe den WordPress-Cron mit dieser Crontab-Zeile vom Server aus:"

#: includes/class-cron-health.php:214
msgid "This site sets DISABLE_WP_CRON and no scheduled run has been seen."
msgstr "Diese Website setzt DISABLE_WP_CRON und es wurde keine geplante Ausführung beobachtet."

#: includes/class-cron-health.php:215
msgid "No scheduled run has been seen for more than three hours."
msgstr "Seit mehr als drei Stunden wurde keine geplante Ausführung beobachtet."

#. translators: %d: number of leads waiting for delivery.
#: includes/class-cron-health.php:221
#, php-format
msgid "%d lead is waiting for delivery."
msgid_plural "%d leads are waiting for delivery."
msgstr[0] "%d Lead wartet auf Zustellung."
msgstr[1] "%d Leads warten auf Zustellung."

#: includes/class-embed-script.php:206
msgid "This gallery could not be loaded. Please try again later."
msgstr "Diese Galerie konnte nicht geladen werden. Bitte versuche es später erneut."

#: includes/class-gallery-renderer.php:323
msgid "The Profotograaf gallery cannot be shown because its gallery ID is missing or not valid. Choose the gallery again."
msgstr "Die Profotograaf-Galerie kann nicht angezeigt werden, weil ihre Galerie-ID fehlt oder ungültig ist. Wähle die Galerie erneut aus."

#: includes/class-gallery-renderer.php:334
msgid "This Profotograaf gallery was not found in your account. It may have been deleted. Choose another gallery."
msgstr "Diese Profotograaf-Galerie wurde in deinem Konto nicht gefunden. Sie wurde möglicherweise gelöscht. Wähle eine andere Galerie."

#: includes/class-gallery-renderer.php:355
msgid "This gallery needs JavaScript to be shown here."
msgstr "Diese Galerie benötigt JavaScript, um hier angezeigt zu werden."

#: includes/class-fallback-link.php:68
msgid "View this gallery on Profotograaf"
msgstr "Diese Galerie auf Profotograaf ansehen"

#: includes/class-pairing.php:105
msgid "Profotograaf did not start the connection. Try again in a moment."
msgstr "Profotograaf hat die Verbindung nicht gestartet. Versuche es gleich noch einmal."

#: includes/class-pairing.php:232
msgid "Could not check the connection. Trying again."
msgstr "Die Verbindung konnte nicht geprüft werden. Ein neuer Versuch läuft."

#: includes/class-pairing.php:254
msgid "Profotograaf approved the connection but sent no tokens. Start again."
msgstr "Profotograaf hat die Verbindung genehmigt, aber keine Token gesendet. Starte erneut."

#: includes/class-settings-schema.php:60
msgid "General"
msgstr "Allgemein"

#: includes/class-settings-schema.php:61
#: includes/modules/class-privacy.php:229
msgid "Galleries"
msgstr "Galerien"

#: includes/class-settings-schema.php:63
msgid "Advanced"
msgstr "Erweitert"

#: includes/class-settings-schema.php:87
msgid "Gallery link text"
msgstr "Text des Galerielinks"

#: includes/class-settings-schema.php:88
msgid "Text of the link shown until a gallery loads, for galleries without a title. Leave empty to use \"View the gallery\"."
msgstr "Text des Links, der angezeigt wird, bis eine Galerie geladen ist, für Galerien ohne Titel. Leer lassen, um \"Galerie ansehen\" zu verwenden."

#: includes/class-settings-schema.php:94
msgid "Client portal path"
msgstr "Pfad des Kundenportals"

#: includes/class-settings-schema.php:95
msgid "The path of the client portal on your Profotograaf address, used by the \"Find your gallery\" block. A block can set its own. The default is /client."
msgstr "Der Pfad des Kundenportals unter deiner Profotograaf-Adresse, verwendet vom Block \"Finde deine Galerie\". Ein Block kann einen eigenen festlegen. Standard ist /client."

#: includes/class-settings-schema.php:109
msgid "Default gallery layout"
msgstr "Standard-Galerielayout"

#: includes/class-settings-schema.php:110
msgid "Used when a gallery block or shortcode does not choose a layout."
msgstr "Wird verwendet, wenn ein Galerieblock oder Shortcode kein Layout wählt."

#: includes/class-settings-schema.php:112
#: build/gallery/index.js:1
msgid "Grid"
msgstr "Raster"

#: includes/class-settings-schema.php:113
#: build/gallery/index.js:1
msgid "Masonry"
msgstr "Masonry"

#: includes/class-settings-schema.php:114
#: build/gallery/index.js:1
msgid "Slideshow"
msgstr "Diashow"

#: includes/class-settings-schema.php:121
msgid "Collect enquiries"
msgstr "Anfragen sammeln"

#: includes/class-settings-schema.php:122
msgid "Listen for submissions of supported form plugins. Each form still has its own switch on the enquiry forms screen."
msgstr "Auf Einsendungen unterstützter Formular-Plugins reagieren. Jedes Formular hat weiterhin einen eigenen Schalter auf dem Bildschirm der Anfrageformulare."

#: includes/class-settings-schema.php:128
msgid "Failure alerts go to"
msgstr "Fehlerbenachrichtigungen gehen an"

#: includes/class-settings-schema.php:129
msgid "Receives one email, without personal data, when an enquiry cannot be delivered or is dropped. Leave empty to use the site admin email address."
msgstr "Erhält eine E-Mail ohne personenbezogene Daten, wenn eine Anfrage nicht zugestellt werden kann oder verworfen wird. Leer lassen, um die E-Mail-Adresse des Website-Administrators zu verwenden."

#: includes/class-settings-schema.php:136
msgid "Mail undeliverable enquiries to"
msgstr "Nicht zustellbare Anfragen per E-Mail senden an"

#: includes/class-settings-schema.php:137
msgid "When an enquiry cannot be delivered to Profotograaf, send it by email to this address instead. The email contains the enquiry. Leave empty to turn this off."
msgstr "Wenn eine Anfrage nicht an Profotograaf zugestellt werden kann, wird sie stattdessen per E-Mail an diese Adresse gesendet. Die E-Mail enthält die Anfrage. Leer lassen, um dies auszuschalten."

#: includes/class-settings-schema.php:146
msgid "Keep undeliverable enquiries for (days)"
msgstr "Nicht zustellbare Anfragen aufbewahren für (Tage)"

#: includes/class-settings-schema.php:147
msgid "Enquiries that could not be delivered stay in the database until you export them or this many days have passed, from 1 to 90. You get an email before they are removed."
msgstr "Anfragen, die nicht zugestellt werden konnten, bleiben in der Datenbank, bis du sie exportierst oder diese Anzahl an Tagen von 1 bis 90 vergangen ist. Du erhältst vor dem Entfernen eine E-Mail."

#: includes/class-settings-schema.php:153
msgid "Share anonymous usage data"
msgstr "Anonyme Nutzungsdaten teilen"

#: includes/class-settings-schema.php:154
msgid "Help improve Profotograaf by sharing anonymous usage and error data. This is optional and you can turn it off at any time. No personal information is collected. Turning it off stops sending at once and deletes data that is waiting to be sent."
msgstr "Hilf mit, Profotograaf zu verbessern, indem du anonyme Nutzungs- und Fehlerdaten teilst. Das ist optional und du kannst es jederzeit ausschalten. Es werden keine personenbezogenen Daten erhoben. Beim Ausschalten wird das Senden sofort gestoppt und Daten, die auf den Versand warten, werden gelöscht."

#: includes/class-settings-schema.php:157
#: includes/modules/class-telemetry-consent.php:108
msgid "What is shared"
msgstr "Was geteilt wird"

#: includes/class-settings-schema.php:164
msgid "Keep my data when the plugin is deleted"
msgstr "Meine Daten behalten, wenn das Plugin gelöscht wird"

#: includes/class-settings-schema.php:165
msgid "Leave the settings and the connection in the database when you delete the plugin, for example to reinstall it later."
msgstr "Lass die Einstellungen und die Verbindung in der Datenbank, wenn du das Plugin löschst, zum Beispiel um es später neu zu installieren."

#: includes/class-settings-schema.php:179
