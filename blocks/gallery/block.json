{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "profotograaf/gallery",
	"version": "0.1.0",
	"title": "Profotograaf gallery",
	"category": "media",
	"icon": "format-gallery",
	"description": "Show one of your Profotograaf galleries as a grid, masonry or slideshow.",
	"keywords": [
		"gallery",
		"photos",
		"profotograaf",
		"portfolio"
	],
	"textdomain": "profotograaf",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		},
		"galleryId": {
			"type": "string",
			"default": ""
		},
		"galleryTitle": {
			"type": "string",
			"default": ""
		},
		"galleryUrl": {
			"type": "string",
			"default": ""
		},
		"layout": {
			"type": "string",
			"enum": [
				"",
				"grid",
				"masonry",
				"slideshow"
			],
			"default": ""
		},
		"columns": {
			"type": "string",
			"default": ""
		},
		"columnsTablet": {
			"type": "string",
			"default": ""
		},
		"columnsMobile": {
			"type": "string",
			"default": ""
		},
		"gap": {
			"type": "string",
			"default": ""
		},
		"ratio": {
			"type": "string",
			"default": ""
		},
		"captions": {
			"type": "string",
			"default": ""
		},
		"sort": {
			"type": "string",
			"default": ""
		},
		"perPage": {
			"type": "string",
			"default": ""
		},
		"loadMore": {
			"type": "string",
			"default": ""
		},
		"lightbox": {
			"type": "string",
			"default": ""
		},
		"excludedPhotoIds": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"default": []
		},
		"linkTo": {
			"type": "string",
			"default": ""
		},
		"linkNewTab": {
			"type": "string",
			"default": ""
		},
		"imageText": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"variations": [
		{
			"name": "grid",
			"title": "Profotograaf grid gallery",
			"description": "Show a Profotograaf gallery as an even grid.",
			"icon": "grid-view",
			"keywords": [ "grid" ],
			"attributes": { "layout": "grid" },
			"scope": [ "inserter", "transform" ],
			"isActive": [ "layout" ]
		},
		{
			"name": "masonry",
			"title": "Profotograaf masonry gallery",
			"description": "Show a Profotograaf gallery in masonry layout, each photo at its own height.",
			"icon": "images-alt2",
			"keywords": [ "masonry" ],
			"attributes": { "layout": "masonry" },
			"scope": [ "inserter", "transform" ],
			"isActive": [ "layout" ]
		},
		{
			"name": "slideshow",
			"title": "Profotograaf slideshow",
			"description": "Show a Profotograaf gallery as a slideshow.",
			"icon": "slides",
			"keywords": [ "slideshow", "slider" ],
			"attributes": { "layout": "slideshow" },
			"scope": [ "inserter", "transform" ],
			"isActive": [ "layout" ]
		}
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"className": true,
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"filter": {
			"duotone": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"selectors": {
		"filter": {
			"duotone": ".wp-block-profotograaf-gallery img"
		}
	}
}
