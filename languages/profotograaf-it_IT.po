msgstr "Profotograaf non ha accettato il file."

#: includes/class-backup-labels.php:56
msgid "The file was sent but Profotograaf did not answer. It may be there already."
msgstr "Il file è stato inviato ma Profotograaf non ha risposto. Potrebbe essere già lì."

#: includes/class-backup-labels.php:57
msgid "The upload was interrupted. The file may be on Profotograaf already."
msgstr "Il caricamento è stato interrotto. Il file potrebbe essere già su Profotograaf."

#: includes/class-backup-labels.php:58
msgid "The file is too large for the memory of this site."
msgstr "Il file è troppo grande per la memoria di questo sito."

#. translators: %d: HTTP status code, for example 500.
#: includes/class-backup-labels.php:65
#, php-format
msgid "Profotograaf answered with error %d."
msgstr "Profotograaf ha risposto con l'errore %d."

#. translators: %s: error code.
#: includes/class-backup-labels.php:71
#, php-format
msgid "The upload failed (%s)."
msgstr "Il caricamento non è riuscito (%s)."

#: includes/modules/class-admin-notices.php:183
msgid "Your Profotograaf storage is full, so the backup is paused. Free up space or upgrade your plan, then press Back up now."
msgstr "Il tuo spazio di archiviazione Profotograaf è pieno, quindi il backup è in pausa. Libera spazio o passa a un piano superiore, poi premi Esegui il backup ora."

#. translators: %d: number of files.
#: includes/modules/class-admin-notices.php:195
#, php-format
msgid "%d file could not be backed up to Profotograaf."
msgid_plural "%d files could not be backed up to Profotograaf."
msgstr[0] "Non è stato possibile eseguire il backup di %d file su Profotograaf."
msgstr[1] "Non è stato possibile eseguire il backup di %d file su Profotograaf."

#: includes/modules/class-admin-notices.php:199
msgid "See why and retry"
msgstr "Vedi il motivo e riprova"

#: includes/modules/class-backup-admin.php:115
msgid "Not in the backup"
msgstr "Non nel backup"

#. translators: %s: date the file was copied.
#: includes/modules/class-backup-admin.php:119
#, php-format
msgid "Backed up to Profotograaf on %s."
msgstr "Backup su Profotograaf eseguito il %s."

#: includes/modules/class-backup-admin.php:126
msgid "Retry it on the Backup tab"
msgstr "Riprova nella scheda Backup"

#: includes/modules/class-backup-admin.php:145
msgid "Back up to Profotograaf"
msgstr "Esegui il backup su Profotograaf"

#: includes/modules/class-backup-admin.php:146
msgid "Do not back up"
msgstr "Non eseguire il backup"

#. translators: %d: number of files.
#: includes/modules/class-backup-admin.php:192
#, php-format
msgid "%d file is no longer marked for the backup. A file that is backed up already stays on Profotograaf."
msgid_plural "%d files are no longer marked for the backup. Files that are backed up already stay on Profotograaf."
msgstr[0] "%d file non è più contrassegnato per il backup. Un file già nel backup resta su Profotograaf."
msgstr[1] "%d file non sono più contrassegnati per il backup. I file già nel backup restano su Profotograaf."

#. translators: %d: number of files.
#: includes/modules/class-backup-admin.php:198
#, php-format
msgid "%d file is marked for the backup. It is copied to Profotograaf in the background."
msgid_plural "%d files are marked for the backup. They are copied to Profotograaf in the background."
msgstr[0] "%d file è contrassegnato per il backup. Viene copiato su Profotograaf in background."
msgstr[1] "%d file sono contrassegnati per il backup. Vengono copiati su Profotograaf in background."

#: includes/modules/class-backup.php:172
msgid "The backup starts within a minute, in the background. You can leave this page."
msgstr "Il backup parte entro un minuto, in background. Puoi lasciare questa pagina."

#: includes/modules/class-backup.php:173
msgid "The backup cannot start: switch it on and connect this site to Profotograaf first."
msgstr "Il backup non può partire: prima attivalo e collega questo sito a Profotograaf."

#. translators: %d: number of files.
#: includes/modules/class-backup.php:187
#, php-format
msgid "%d file will be sent again in the background."
msgid_plural "%d files will be sent again in the background."
msgstr[0] "%d file verrà inviato di nuovo in background."
msgstr[1] "%d file verranno inviati di nuovo in background."

