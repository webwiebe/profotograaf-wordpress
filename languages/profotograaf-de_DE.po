msgstr "Spalten auf Smartphones"

#: includes/class-settings-schema.php:212
msgid "Columns on narrow screens, from 1 to 4."
msgstr "Spalten auf schmalen Bildschirmen, von 1 bis 4."

#: includes/class-settings-schema.php:220
#: build/gallery/index.js:3
msgid "Gap between photos (pixels)"
msgstr "Abstand zwischen Fotos (Pixel)"

#: includes/class-settings-schema.php:221
msgid "Space between photos, from 0 to 96 pixels."
msgstr "Abstand zwischen den Fotos, von 0 bis 96 Pixel."

#: includes/class-settings-schema.php:227
#: build/gallery/index.js:3
msgid "Photo shape"
msgstr "Fotoform"

#: includes/class-settings-schema.php:228
msgid "Crop every photo to one aspect ratio, or keep each photo as shot."
msgstr "Beschneide jedes Foto auf ein Seitenverhältnis oder behalte jedes Foto, wie es aufgenommen wurde."

#: includes/class-settings-schema.php:230
#: build/gallery/index.js:3
msgid "Original"
msgstr "Original"

#: includes/class-settings-schema.php:231
#: build/gallery/index.js:3
