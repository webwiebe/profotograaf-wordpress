#: includes/class-photo-list.php:56
msgid "A gallery id is required."
msgstr "Serve un ID galleria."

#: includes/class-api-client.php:165
msgid "The request to switch embedding on is not valid."
msgstr "La richiesta di attivare l'incorporamento non è valida."

#: includes/class-api-client.php:175
msgid "This connection may not switch galleries on yet. Connect this site again under Settings > Profotograaf to grant the new permission."
msgstr "Questa connessione non può ancora attivare le gallerie. Ricollega questo sito in Impostazioni > Profotograaf per concedere il nuovo permesso."

#: includes/class-api-client.php:214
msgid "A lead needs a name and an email address."
msgstr "Un contatto richiede un nome e un indirizzo email."

#: includes/class-api-client.php:316
msgid "That page is not on the Profotograaf platform."
msgstr "Quella pagina non appartiene alla piattaforma Profotograaf."

#: includes/class-api-client.php:326
#: includes/class-api-client.php:466
#: includes/class-api-client.php:471
msgid "Profotograaf could not be reached."
msgstr "Non è stato possibile raggiungere Profotograaf."

#: includes/class-api-client.php:333
msgid "The public page could not be loaded."
msgstr "Non è stato possibile caricare la pagina pubblica."

#: includes/class-api-client.php:358
msgid "The connection is being refreshed. Try again in a moment."
msgstr "La connessione è in fase di rinnovo. Riprova tra un momento."

#: includes/class-api-client.php:382
msgid "The connection was ended in your Profotograaf account."
msgstr "La connessione è stata terminata nel tuo account Profotograaf."

#: includes/class-api-client.php:451
msgid "The request could not be encoded."
msgstr "Non è stato possibile codificare la richiesta."

#: includes/class-api-errors.php:62
msgid "The connection to Profotograaf has expired. Connect this site again."
msgstr "La connessione a Profotograaf è scaduta. Ricollega questo sito."

#: includes/class-api-errors.php:64
msgid "Profotograaf asked for fewer connection checks. Trying again shortly."
msgstr "Profotograaf ha chiesto meno controlli della connessione. Nuovo tentativo a breve."

#: includes/class-api-errors.php:66
msgid "Profotograaf does not know this connection code. Start the connection again."
msgstr "Profotograaf non riconosce questo codice di connessione. Avvia di nuovo la connessione."

#: includes/class-api-errors.php:68
msgid "Profotograaf does not recognise this site. Start the connection again."
msgstr "Profotograaf non riconosce questo sito. Avvia di nuovo la connessione."

#: includes/class-api-errors.php:70
msgid "Profotograaf rejected the enquiry because it is incomplete or invalid."
msgstr "Profotograaf ha rifiutato la richiesta perché è incompleta o non valida."

#: includes/class-api-errors.php:80
msgid "This site is not connected to Profotograaf."
msgstr "Questo sito non è collegato a Profotograaf."

#. translators: %d: HTTP status code.
#: includes/class-api-errors.php:105
#, php-format
msgid "The platform reported an error (HTTP %d). Try again later."
msgstr "La piattaforma ha segnalato un errore (HTTP %d). Riprova più tardi."

#. translators: %d: HTTP status code.
#: includes/class-api-errors.php:109
#, php-format
msgid "Profotograaf answered with HTTP %d."
msgstr "Profotograaf ha risposto con HTTP %d."

#: includes/class-cron-health.php:142
msgid "Profotograaf lead delivery"
msgstr "Consegna dei contatti Profotograaf"

#: includes/class-cron-health.php:157
msgid "Profotograaf can deliver leads"
msgstr "Profotograaf può consegnare i contatti"

#: includes/class-cron-health.php:163
msgid "WP-Cron has run recently, so queued leads are delivered on time."
msgstr "WP-Cron è stato eseguito di recente, quindi i contatti in coda vengono consegnati in tempo."

#: includes/class-cron-health.php:171
msgid "WP-Cron is disabled and leads cannot be delivered"
msgstr "WP-Cron è disattivato e i contatti non possono essere consegnati"

#: includes/class-cron-health.php:172
msgid "WP-Cron has stopped running and leads cannot be delivered"
msgstr "WP-Cron ha smesso di funzionare e i contatti non possono essere consegnati"

#: includes/class-cron-health.php:179
msgid "Run WordPress cron from the server. Add this line to the crontab of the site:"
msgstr "Esegui il cron di WordPress dal server. Aggiungi questa riga al crontab del sito:"

#: includes/class-cron-health.php:195
msgid "Run WordPress cron from the server with this crontab line:"
msgstr "Esegui il cron di WordPress dal server con questa riga di crontab:"

#: includes/class-cron-health.php:214
msgid "This site sets DISABLE_WP_CRON and no scheduled run has been seen."
msgstr "Questo sito imposta DISABLE_WP_CRON e non è stata rilevata alcuna esecuzione pianificata."

#: includes/class-cron-health.php:215
msgid "No scheduled run has been seen for more than three hours."
msgstr "Non è stata rilevata alcuna esecuzione pianificata da più di tre ore."

#. translators: %d: number of leads waiting for delivery.
#: includes/class-cron-health.php:221
#, php-format
msgid "%d lead is waiting for delivery."
msgid_plural "%d leads are waiting for delivery."
msgstr[0] "%d contatto è in attesa di consegna."
msgstr[1] "%d contatti sono in attesa di consegna."

#: includes/class-embed-script.php:206
msgid "This gallery could not be loaded. Please try again later."
msgstr "Non è stato possibile caricare questa galleria. Riprova più tardi."

#: includes/class-gallery-renderer.php:320
msgid "The Profotograaf gallery cannot be shown because its gallery ID is missing or not valid. Choose the gallery again."
msgstr "La galleria Profotograaf non può essere mostrata perché il suo ID manca o non è valido. Scegli di nuovo la galleria."

#: includes/class-gallery-renderer.php:335
msgid "This Profotograaf gallery was not found in your account. It may have been deleted. Choose another gallery."
msgstr "Questa galleria Profotograaf non è stata trovata nel tuo account. Potrebbe essere stata eliminata. Scegli un'altra galleria."

#: includes/class-gallery-renderer.php:356
msgid "This gallery needs JavaScript to be shown here."
msgstr "Questa galleria richiede JavaScript per essere mostrata qui."

#: includes/class-fallback-link.php:68
msgid "View this gallery on Profotograaf"
msgstr "Guarda questa galleria su Profotograaf"

#: includes/class-pairing.php:105
msgid "Profotograaf did not start the connection. Try again in a moment."
msgstr "Profotograaf non ha avviato la connessione. Riprova tra un momento."

#: includes/class-pairing.php:232
msgid "Could not check the connection. Trying again."
msgstr "Non è stato possibile controllare la connessione. Nuovo tentativo in corso."

#: includes/class-pairing.php:254
msgid "Profotograaf approved the connection but sent no tokens. Start again."
msgstr "Profotograaf ha approvato la connessione ma non ha inviato token. Ricomincia."

