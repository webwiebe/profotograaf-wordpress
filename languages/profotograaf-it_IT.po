msgid "Backup failed"
msgstr "Backup non riuscito"

#: includes/class-backup-labels.php:39
msgid "Backup not confirmed"
msgstr "Backup non confermato"

#: includes/class-backup-labels.php:41
msgid "Marked for the backup"
msgstr "Contrassegnato per il backup"

#: includes/class-backup-labels.php:51
msgid "It came from Profotograaf, so it is there already."
msgstr "Proviene da Profotograaf, quindi è già lì."

#: includes/class-backup-labels.php:52
msgid "The file is missing on this server."
msgstr "Il file manca su questo server."

#: includes/class-backup-labels.php:53
msgid "The file is larger than 100 MB, the most Profotograaf accepts."
msgstr "Il file supera i 100 MB, il massimo accettato da Profotograaf."

