#. Plugin Name of the plugin
#: profotograaf.php
msgid "Profotograaf for WordPress"
msgstr ""

#. Plugin URI of the plugin
#: profotograaf.php
msgid "https://github.com/webwiebe/profotograaf-wordpress"
msgstr ""

#. Description of the plugin
#: profotograaf.php
msgid "Show your Profotograaf galleries on your own site, offer clients a way in, and send form enquiries to your Profotograaf inbox."
msgstr "Toon je Profotograaf-galerijen op je eigen site, geef klanten een ingang en stuur aanvragen uit formulieren naar je Profotograaf-inbox."

#. Author of the plugin
#: profotograaf.php
#: includes/modules/class-settings-page.php:66
#: includes/modules/class-settings-page.php:67
#: includes/modules/class-settings-page.php:216
msgid "Profotograaf"
msgstr ""

#. Author URI of the plugin
#: profotograaf.php
msgid "https://profotograaf.nl"
msgstr ""

#: includes/class-api-client.php:142
#: includes/class-gallery-rest.php:123
msgid "A gallery id is required."
msgstr "Een galerij-id is verplicht."

#: includes/class-api-client.php:155
msgid "Turn on \"Allow embedding on other websites\" in the gallery settings in Profotograaf."
msgstr "Zet \"Insluiten op andere websites toestaan\" aan in de galerij-instellingen in Profotograaf."

#: includes/class-api-client.php:192
msgid "A lead needs a name and an email address."
msgstr "Een aanvraag heeft een naam en een e-mailadres nodig."

#: includes/class-api-client.php:286
msgid "The connection is being refreshed. Try again in a moment."
msgstr "De verbinding wordt vernieuwd. Probeer het zo opnieuw."

#: includes/class-api-client.php:308
msgid "The connection was ended in your Profotograaf account."
msgstr "De verbinding is beëindigd in je Profotograaf-account."

#: includes/class-api-client.php:376
msgid "The request could not be encoded."
msgstr "Het verzoek kon niet worden gecodeerd."

#: includes/class-api-client.php:383
#: includes/class-api-client.php:387
msgid "Profotograaf could not be reached."
msgstr "Profotograaf is niet bereikbaar."

#. translators: %d: HTTP status code.
#: includes/class-api-client.php:408
#, php-format
msgid "Profotograaf answered with HTTP %d."
msgstr "Profotograaf antwoordde met HTTP %d."

#: includes/class-api-client.php:445
msgid "This site is not connected to Profotograaf."
msgstr "Deze site is niet verbonden met Profotograaf."

#: includes/class-gallery-renderer.php:122
msgid "View the gallery"
msgstr "Bekijk de galerij"

#: includes/class-pairing.php:92
msgid "Profotograaf did not start the connection. Try again in a moment."
msgstr "Profotograaf heeft de verbinding niet gestart. Probeer het zo opnieuw."

#: includes/class-pairing.php:184
msgid "Could not check the connection. Trying again."
msgstr "De verbinding kon niet worden gecontroleerd. Nieuwe poging."

#: includes/class-pairing.php:206
msgid "Profotograaf approved the connection but sent no tokens. Start again."
msgstr "Profotograaf keurde de verbinding goed maar stuurde geen tokens. Begin opnieuw."

#: includes/modules/class-settings-page.php:99
#: includes/modules/class-settings-page.php:244
msgid "Settings"
msgstr "Instellingen"

#: includes/modules/class-settings-page.php:122
#: includes/modules/class-settings-page.php:296
msgid "Waiting for you to approve the connection in Profotograaf."
msgstr "Wachten tot je de verbinding goedkeurt in Profotograaf."

#: includes/modules/class-settings-page.php:123
msgid "Could not check the connection. Reload this page to try again."
msgstr "De verbinding kon niet worden gecontroleerd. Laad deze pagina opnieuw om het nog eens te proberen."

#: includes/modules/class-settings-page.php:157
msgid "Disconnected from Profotograaf."
msgstr "Verbinding met Profotograaf verbroken."

#: includes/modules/class-settings-page.php:161
msgid "Disconnected. This site no longer has access. To also remove it from your account, open Connected apps in your Profotograaf account settings."
msgstr "Verbinding verbroken. Deze site heeft geen toegang meer. Om de site ook uit je account te verwijderen, open je Gekoppelde apps in de instellingen van je Profotograaf-account."

#: includes/modules/class-settings-page.php:182
#: includes/modules/class-settings-page.php:209
#: includes/modules/class-settings-page.php:399
msgid "You do not have permission to do this."
msgstr "Je hebt hier geen toestemming voor."

#: includes/modules/class-settings-page.php:192
msgid "Connected to Profotograaf."
msgstr "Verbonden met Profotograaf."

#: includes/modules/class-settings-page.php:195
msgid "The connection was declined in Profotograaf."
msgstr "De verbinding is geweigerd in Profotograaf."

#: includes/modules/class-settings-page.php:198
msgid "The code expired. Start the connection again."
msgstr "De code is verlopen. Start de verbinding opnieuw."

#: includes/modules/class-settings-page.php:219
msgid "Connection"
msgstr "Verbinding"

#: includes/modules/class-settings-page.php:222
msgid "Connected"
msgstr "Verbonden"

#. translators: %s: date the site was connected.
#: includes/modules/class-settings-page.php:226
#, php-format
msgid "since %s."
msgstr "sinds %s."

#: includes/modules/class-settings-page.php:230
msgid "Disconnect"
msgstr "Verbinding verbreken"

#: includes/modules/class-settings-page.php:235
msgid "Not connected"
msgstr "Niet verbonden"

#: includes/modules/class-settings-page.php:240
msgid "Connect this site to your Profotograaf account to place galleries and receive enquiries. You approve the connection in Profotograaf, so your password never reaches this site."
msgstr "Verbind deze site met je Profotograaf-account om galerijen te plaatsen en aanvragen te ontvangen. Je keurt de verbinding goed in Profotograaf, dus je wachtwoord komt nooit op deze site."

#: includes/modules/class-settings-page.php:241
msgid "Connect to Profotograaf"
msgstr "Verbinden met Profotograaf"

#: includes/modules/class-settings-page.php:249
msgid "Default gallery layout"
msgstr "Standaardindeling van galerijen"

#: includes/modules/class-settings-page.php:256
msgid "Used when a gallery block or shortcode does not choose a layout."
msgstr "Wordt gebruikt als een galerijblok of shortcode geen indeling kiest."

#: includes/modules/class-settings-page.php:277
#: blocks/gallery/edit.js:27
msgid "Grid"
msgstr "Raster"

#: includes/modules/class-settings-page.php:278
#: blocks/gallery/edit.js:28
msgid "Masonry"
msgstr "Metselwerk"

#: includes/modules/class-settings-page.php:279
#: blocks/gallery/edit.js:29
msgid "Slideshow"
msgstr "Diavoorstelling"

#: includes/modules/class-settings-page.php:291
msgid "Confirm this code in Profotograaf to finish connecting:"
msgstr "Bevestig deze code in Profotograaf om het verbinden af te ronden:"

#: includes/modules/class-settings-page.php:294
msgid "Open the approval page"
msgstr "Open de goedkeuringspagina"

#: includes/modules/class-settings-page.php:297
msgid "Cancel"
msgstr "Annuleren"

#: includes/modules/class-settings-page.php:308
msgid "Embedding on this site"
msgstr "Insluiten op deze site"

#. translators: %s: site address, for example https://example.com.
#: includes/modules/class-settings-page.php:313
#, php-format
msgid "%s is allowed to show your Profotograaf pages in a frame."
msgstr "%s mag je Profotograaf-pagina's in een frame tonen."

#: includes/modules/class-settings-page.php:317
msgid "Profotograaf only allows embedding on sites served over https. Serve this site over https to embed your pages in a frame."
msgstr "Profotograaf staat insluiten alleen toe op sites die via https worden aangeboden. Bied deze site aan via https om je pagina's in een frame in te sluiten."

#. translators: %s: site address, for example https://example.com.
#: includes/modules/class-settings-page.php:322
#, php-format
msgid "To show your Profotograaf pages in a frame on this site, add %s under \"Sites allowed to embed my pages\" in your Profotograaf account settings."
msgstr "Om je Profotograaf-pagina's in een frame op deze site te tonen, voeg je %s toe onder \"Sites die mijn pagina's mogen insluiten\" in de instellingen van je Profotograaf-account."

#: includes/modules/class-settings-page.php:330
msgid "Check again"
msgstr "Opnieuw controleren"

#. translators: %d: number of photos in a gallery.
#: blocks/gallery/edit.js:19
#, js-format
msgid "%d photo"
msgid_plural "%d photos"
msgstr[0] "%d foto"
msgstr[1] "%d foto's"

#: blocks/gallery/edit.js:26
msgid "Site default"
msgstr "Standaard van de site"

#: blocks/gallery/edit.js:35
msgid "Connect this site to Profotograaf under Settings > Profotograaf to pick a gallery."
msgstr "Verbind deze site met Profotograaf onder Instellingen > Profotograaf om een galerij te kiezen."

#: blocks/gallery/edit.js:42
msgid "The galleries could not be loaded."
msgstr "De galerijen konden niet worden geladen."

#: blocks/gallery/edit.js:73
msgid "There are no galleries in your Profotograaf account yet."
msgstr "Er staan nog geen galerijen in je Profotograaf-account."

#: blocks/gallery/edit.js:136
msgid "This gallery cannot be shown on other sites right now. A password, an expiry date, proofing mode or a client-only setting stops embedding."
msgstr "Deze galerij kan nu niet op andere sites worden getoond. Een wachtwoord, een vervaldatum, keuzemodus of een instelling alleen voor de klant staat insluiten niet toe."

#: blocks/gallery/edit.js:158
msgid "Gallery"
msgstr "Galerij"

#: blocks/gallery/edit.js:160
msgid "Layout"
msgstr "Indeling"

#: blocks/gallery/edit.js:179
msgid "Choose another gallery"
msgstr "Kies een andere galerij"

#: blocks/gallery/edit.js:188
#: blocks/gallery/edit.js:208
msgid "Profotograaf gallery"
msgstr "Profotograaf-galerij"

#: blocks/gallery/edit.js:189
msgid "Choose one of your galleries."
msgstr "Kies een van je galerijen."

#. translators: %s: layout name such as grid.
#: blocks/gallery/edit.js:219
#, js-format
msgid "layout: %s"
msgstr "indeling: %s"

#: blocks/gallery/block.json
msgctxt "block title"
msgid "Profotograaf gallery"
msgstr "Profotograaf-galerij"

#: blocks/gallery/block.json
msgctxt "block description"
msgid "Show one of your Profotograaf galleries as a grid, masonry or slideshow."
msgstr "Toon een van je Profotograaf-galerijen als raster, metselwerk of diavoorstelling."

#: blocks/gallery/block.json
msgctxt "block keyword"
msgid "gallery"
msgstr "galerij"

#: blocks/gallery/block.json
msgctxt "block keyword"
msgid "photos"
msgstr "foto's"

#: blocks/gallery/block.json
msgctxt "block keyword"
msgid "profotograaf"
msgstr "profotograaf"

#: blocks/gallery/block.json
msgctxt "block keyword"
msgid "portfolio"
msgstr "portfolio"
