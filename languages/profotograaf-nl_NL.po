#. Description of the plugin
#: profotograaf.php
msgid "Show your Profotograaf galleries on your own site, offer clients a way in, and send form enquiries to your Profotograaf inbox."
msgstr "Toon je Profotograaf-galerijen op je eigen site, geef klanten een ingang en stuur aanvragen uit formulieren naar je Profotograaf-inbox."

#. Author URI of the plugin
#: profotograaf.php
msgid "https://profotograaf.nl"
msgstr ""

#: includes/admin/class-leads-settings.php:96
#: includes/admin/class-leads-settings.php:156
msgid "Profotograaf enquiries"
msgstr "Profotograaf-aanvragen"

#: includes/admin/class-leads-settings.php:97
#: includes/class-settings-schema.php:51
msgid "Enquiry forms"
msgstr "Aanvraagformulieren"

#: includes/admin/class-leads-settings.php:150
#: includes/admin/class-leads-settings.php:345
#: includes/modules/class-settings-page.php:207
#: includes/modules/class-settings-page.php:234
#: includes/modules/class-settings-page.php:430
msgid "You do not have permission to do this."
msgstr "Je hebt hier geen toestemming voor."

#: includes/admin/class-leads-settings.php:159
msgid "Send the enquiries from your contact forms to your Profotograaf inbox. Switch a form on and check which field feeds which part of the enquiry. Nothing is sent for a form you leave off."
msgstr "Stuur de aanvragen uit je contactformulieren naar je Profotograaf-inbox. Zet een formulier aan en controleer welk veld welk deel van de aanvraag vult. Voor een formulier dat uit staat wordt niets verstuurd."

#: includes/admin/class-leads-settings.php:164
msgid "This site is not connected to Profotograaf, so enquiries wait in a queue."
msgstr "Deze site is niet verbonden met Profotograaf, dus aanvragen wachten in een wachtrij."

#: includes/admin/class-leads-settings.php:165
msgid "Connect this site"
msgstr "Verbind deze site"

#: includes/admin/class-leads-settings.php:171
msgid "No supported form plugin was found. Install Contact Form 7, WPForms or Gravity Forms and create a form."
msgstr "Er is geen ondersteunde formulierplugin gevonden. Installeer Contact Form 7, WPForms of Gravity Forms en maak een formulier."

#: includes/admin/class-leads-settings.php:179
msgid "Save changes"
msgstr "Wijzigingen opslaan"

#: includes/admin/class-leads-settings.php:183
msgid "Delivery"
msgstr "Bezorging"

#. translators: 1: number of enquiries waiting to be sent, 2: number that could not be sent.
#: includes/admin/class-leads-settings.php:189
#, php-format
msgid "Waiting to be sent: %1$d. Could not be sent: %2$d."
msgstr "Wacht op verzending: %1$d. Kon niet worden verstuurd: %2$d."

#: includes/admin/class-leads-settings.php:214
msgid "Name"
msgstr "Naam"

#: includes/admin/class-leads-settings.php:215
msgid "Email address"
msgstr "E-mailadres"

#: includes/admin/class-leads-settings.php:216
msgid "Phone"
msgstr "Telefoon"

#: includes/admin/class-leads-settings.php:217
msgid "Event date"
msgstr "Datum van de gelegenheid"

#: includes/admin/class-leads-settings.php:218
msgid "Message"
msgstr "Bericht"

#: includes/admin/class-leads-settings.php:228
msgid "Send submissions of this form to Profotograaf"
msgstr "Stuur inzendingen van dit formulier naar Profotograaf"

#. translators: %s: name of the form field that is picked automatically.
#: includes/admin/class-leads-settings.php:247
#, php-format
msgid "Automatic (%s)"
msgstr "Automatisch (%s)"

#: includes/admin/class-leads-settings.php:248
msgid "Automatic (no field found)"
msgstr "Automatisch (geen veld gevonden)"

#: includes/admin/class-leads-settings.php:252
msgid "Do not send"
msgstr "Niet versturen"

#: includes/admin/class-leads-settings.php:261
msgid "Every other field is sent along as a label and value."
msgstr "Alle andere velden gaan mee als label en waarde."

#. translators: 1: form name, 2: error message.
#: includes/admin/class-leads-settings.php:283
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#: includes/admin/class-leads-settings.php:295
msgid "Try again"
msgstr "Opnieuw proberen"

#: includes/admin/class-leads-settings.php:306
msgid "Changes saved."
msgstr "Wijzigingen opgeslagen."

#: includes/admin/class-leads-settings.php:308
msgid "The enquiries are queued again."
msgstr "De aanvragen staan weer in de wachtrij."

#: includes/class-api-client.php:144
#: includes/class-gallery-rest.php:123
msgid "A gallery id is required."
msgstr "Een galerij-id is verplicht."

#: includes/class-api-client.php:161
msgid "The request to switch embedding on is not valid."
msgstr "Het verzoek om insluiten aan te zetten is niet geldig."

#: includes/class-api-client.php:171
msgid "This connection may not switch galleries on yet. Connect this site again under Settings > Profotograaf to grant the new permission."
msgstr "Deze koppeling mag nog geen galerijen aanzetten. Koppel deze site opnieuw via Instellingen > Profotograaf om de nieuwe toestemming te geven."

#: includes/class-api-client.php:210
msgid "A lead needs a name and an email address."
msgstr "Een aanvraag heeft een naam en een e-mailadres nodig."

#: includes/class-api-client.php:348
msgid "The connection is being refreshed. Try again in a moment."
msgstr "De verbinding wordt vernieuwd. Probeer het zo opnieuw."

#: includes/class-api-client.php:372
msgid "The connection was ended in your Profotograaf account."
msgstr "De verbinding is beëindigd in je Profotograaf-account."

#: includes/class-api-client.php:441
msgid "The request could not be encoded."
msgstr "Het verzoek kon niet worden gecodeerd."

#: includes/class-api-client.php:316
#: includes/class-api-client.php:456
#: includes/class-api-client.php:461
msgid "Profotograaf could not be reached."
msgstr "Profotograaf is niet bereikbaar."

#. translators: %d: HTTP status code.
#: includes/class-api-errors.php:55
#, php-format
msgid "Profotograaf answered with HTTP %d."
msgstr "Profotograaf antwoordde met HTTP %d."

#: includes/class-api-errors.php:43
msgid "This site is not connected to Profotograaf."
msgstr "Deze site is niet verbonden met Profotograaf."

#: includes/class-gallery-renderer.php:120
msgid "View the gallery"
msgstr "Bekijk de galerij"

#: includes/class-pairing.php:93
msgid "Profotograaf did not start the connection. Try again in a moment."
msgstr "Profotograaf heeft de verbinding niet gestart. Probeer het zo opnieuw."

#: includes/class-pairing.php:185
msgid "Could not check the connection. Trying again."
msgstr "De verbinding kon niet worden gecontroleerd. Nieuwe poging."

#: includes/class-pairing.php:207
msgid "Profotograaf approved the connection but sent no tokens. Start again."
msgstr "Profotograaf keurde de verbinding goed maar stuurde geen tokens. Begin opnieuw."

#: includes/modules/class-client-galleries.php:171
#: build/client-galleries/index.js:1
msgid "Find your gallery"
msgstr "Vind je galerij"

#: includes/modules/class-client-galleries.php:172
#: build/client-galleries/index.js:1
msgid "Sign in to the client portal to see your photos."
msgstr "Log in op het klantportaal om je foto's te bekijken."

#: includes/modules/class-client-galleries.php:173
#: build/client-galleries/index.js:1
msgid "Open my gallery"
msgstr "Open mijn galerij"

#: includes/modules/class-client-galleries.php:200
msgid "Only editors see this note. The \"Find your gallery\" block has no Profotograaf address yet. Enter it in the block settings. Until then visitors do not see this block."
msgstr "Alleen redacteuren zien deze notitie. Het blok \"Vind je galerij\" heeft nog geen Profotograaf-adres. Vul het in bij de blokinstellingen. Tot die tijd zien bezoekers dit blok niet."

#: includes/modules/class-settings-page.php:103
msgid "Settings"
msgstr "Instellingen"

#: includes/modules/class-settings-page.php:126
#: includes/modules/class-settings-page.php:327
msgid "Waiting for you to approve the connection in Profotograaf."
msgstr "Wachten tot je de verbinding goedkeurt in Profotograaf."

#: includes/modules/class-settings-page.php:127
msgid "Could not check the connection. Reload this page to try again."
msgstr "De verbinding kon niet worden gecontroleerd. Laad deze pagina opnieuw om het nog eens te proberen."

#: includes/modules/class-settings-page.php:148
msgid "Profotograaf needs a new permission to switch galleries on for embedding."
msgstr "Profotograaf heeft een nieuwe toestemming nodig om galerijen aan te zetten voor insluiten."

#: includes/modules/class-settings-page.php:150
msgid "Connect this site again"
msgstr "Koppel deze site opnieuw"

#: includes/modules/class-settings-page.php:182
msgid "Disconnected from Profotograaf."
msgstr "Verbinding met Profotograaf verbroken."

#: includes/modules/class-settings-page.php:186
msgid "Disconnected. This site no longer has access. To also remove it from your account, open Connected apps in your Profotograaf account settings."
msgstr "Verbinding verbroken. Deze site heeft geen toegang meer. Om de site ook uit je account te verwijderen, open je Gekoppelde apps in de instellingen van je Profotograaf-account."

#: includes/modules/class-settings-page.php:217
msgid "Connected to Profotograaf."
msgstr "Verbonden met Profotograaf."

#: includes/modules/class-settings-page.php:220
msgid "The connection was declined in Profotograaf."
msgstr "De verbinding is geweigerd in Profotograaf."

#: includes/modules/class-settings-page.php:223
msgid "The code expired. Start the connection again."
msgstr "De code is verlopen. Start de verbinding opnieuw."

#: includes/modules/class-settings-page.php:247
msgid "Connection"
msgstr "Verbinding"

#: includes/modules/class-settings-page.php:252
msgid "Connected"
msgstr "Verbonden"

#. translators: %s: date the site was connected.
#: includes/modules/class-settings-page.php:256
#, php-format
msgid "since %s."
msgstr "sinds %s."

#: includes/modules/class-settings-page.php:262
msgid "This connection was made before Profotograaf could let this site switch galleries on for embedding. Connect again to grant that permission. Your galleries and settings stay as they are."
msgstr "Deze koppeling is gemaakt voordat Profotograaf deze site galerijen kon laten aanzetten voor insluiten. Koppel opnieuw om die toestemming te geven. Je galerijen en instellingen blijven zoals ze zijn."

#: includes/modules/class-settings-page.php:264
msgid "Connect again"
msgstr "Opnieuw koppelen"

#: includes/modules/class-settings-page.php:266
msgid "Disconnect"
msgstr "Verbinding verbreken"

#: includes/modules/class-settings-page.php:269
msgid "Not connected"
msgstr "Niet verbonden"

#: includes/modules/class-settings-page.php:274
msgid "Connect this site to your Profotograaf account to place galleries and receive enquiries. You approve the connection in Profotograaf, so your password never reaches this site."
msgstr "Verbind deze site met je Profotograaf-account om galerijen te plaatsen en aanvragen te ontvangen. Je keurt de verbinding goed in Profotograaf, dus je wachtwoord komt nooit op deze site."

#: includes/modules/class-settings-page.php:275
msgid "Connect to Profotograaf"
msgstr "Verbinden met Profotograaf"

#: includes/class-settings-schema.php:74
msgid "Default gallery layout"
msgstr "Standaardindeling van galerijen"

#: includes/class-settings-schema.php:75
msgid "Used when a gallery block or shortcode does not choose a layout."
msgstr "Wordt gebruikt als een galerijblok of shortcode geen indeling kiest."

#: includes/class-settings-schema.php:77
#: build/gallery/index.js:2
msgid "Grid"
msgstr "Raster"

