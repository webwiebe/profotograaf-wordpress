{
  "name": "profotograaf-wordpress",
  "version": "0.1.0",
  "private": true,
  "description": "Profotograaf for WordPress: client galleries, embeds and lead capture.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node bin/blocks.mjs build",
    "start": "node bin/blocks.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/oxlint-ratchet.mjs && node scripts/oxlint-ratchet.mjs --type-aware",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:gates": "node --test scripts/*.test.mjs",
    "check:file-length": "node scripts/check-file-length.mjs",
    "test:e2e": "playwright test",
    "e2e:up": "bash tests/e2e/up.sh",
    "e2e:down": "docker compose -f tests/e2e/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wordpress__block-editor": "^15.0.6",
    "@vitest/coverage-v8": "^4.1.11",
    "@wordpress/api-fetch": "^7.56.0",
    "@wordpress/block-editor": "^18.0.0",
    "@wordpress/blocks": "^16.1.0",
    "@wordpress/browserslist-config": "^6.56.0",
    "@wordpress/components": "^41.0.0",
    "@wordpress/data": "^10.56.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/i18n": "^6.29.0",
    "@wordpress/scripts": "^36.0.0",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.4.2"
}
